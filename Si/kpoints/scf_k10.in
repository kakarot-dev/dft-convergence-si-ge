&CONTROL
  calculation='scf'
  prefix='Si'
  pseudo_dir='../../pseudo'
  outdir='./tmp'
/
&SYSTEM
  ibrav=2, celldm(1)=10.2, nat=2, ntyp=1
  ecutwfc=30
  ecutrho=120
/
&ELECTRONS
  conv_thr=1.0d-8
  mixing_beta=0.7
/
ATOMIC_SPECIES
  Si 28.086 Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
  Si 0.0 0.0 0.0
  Si 0.25 0.25 0.25
K_POINTS automatic
  10 10 10 1 1 1
