&CONTROL
  calculation='scf'
  prefix='Ge'
  pseudo_dir='../../pseudo'
  outdir='./tmp'
/
&SYSTEM
  ibrav=2, celldm(1)=10.7, nat=2, ntyp=1
  ecutwfc=30
  ecutrho=120
/
&ELECTRONS
  conv_thr=1.0d-8
  mixing_beta=0.7
/
